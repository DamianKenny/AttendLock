<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ultra-transparent main background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <stroke
                android:width="0.5dp"
                android:color="#20FFFFFF" />
            <corners android:radius="35dp" />
        </shape>
    </item>

    <!-- Top shine effect -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="35dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- Side highlights for depth -->
    <item android:top="1dp" android:left="1dp" android:right="30dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="0" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>