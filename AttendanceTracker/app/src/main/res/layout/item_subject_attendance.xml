<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_subject_attendance"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/orange_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_subject_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_subject"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_subject_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_attendance_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="82%"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="@font/cascadiacode"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_attendance_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18/22"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.9"
                android:layout_marginBottom="6dp" />

            <ProgressBar
                android:id="@+id/progress_attendance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:max="100"
                android:progress="82"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="@android:color/white"
                android:alpha="0.8" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>