<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Status Bar Spacer -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_alignParentTop="true" />

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/statusBarSpacer"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- QR Code Icon with Frame -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="130dp"
            android:layout_marginBottom="40dp">

            <!-- QR Code Background Circle -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginLeft="-20dp"
                android:layout_marginTop="-20dp"
                android:background="@drawable/qr_background_circle" />

            <!-- QR Code Icon -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_qr_code"
                />


        </FrameLayout>

    </LinearLayout>

    <!-- Content Section -->
    <LinearLayout
        android:id="@+id/contentSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerSection"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:background="@drawable/button_background"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Get Started Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get Started"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:fontFamily="@font/cascadiacode"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your all-in-one solution for scanning and\ngenerating QR codes—fast, easy, and secure."
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="@font/cascadiacode"
            android:gravity="center"
            android:layout_gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Student Name Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/student_name_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person_filled"
                app:tint="@color/purple_primary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hello, Student"
                android:fontFamily="@font/cascadiacode"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Scan QR Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanQR"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Scan QR for Attendance"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/scan_button_background"
            android:fontFamily="@font/cascadiacode"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:backgroundTint="@null" />

        <!-- Generate QR Button -->

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_nav_background"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:elevation="16dp"
        android:translationZ="16dp"
        android:alpha="0.95">

        <!-- Home Button -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/nav_button_active"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="100dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home"
                android:layout_marginEnd="6dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Schedule Button -->
        <LinearLayout
            android:id="@+id/nav_second"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_inactive"
            android:minWidth="100dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_schedule3"
                android:layout_marginEnd="6dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- QR Scan Button -->
        <LinearLayout
            android:id="@+id/nav_third"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_inactive"
            android:minWidth="100dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_qr_code"
                android:layout_marginEnd="6dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Attendance Button -->
        <LinearLayout
            android:id="@+id/nav_fourth"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_inactive"
            android:minWidth="100dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_attendance2"
                android:layout_marginEnd="6dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Profile Button -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/nav_button_inactive"
            android:minWidth="100dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_profile"
                android:layout_marginEnd="6dp"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>