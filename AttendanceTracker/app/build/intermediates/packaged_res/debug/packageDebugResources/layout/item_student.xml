<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_student"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_student_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_student"
            android:background="@drawable/circle_blue_bg"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_student_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:fontFamily="@font/cascadiacode"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_student_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COHNDSE242F-089"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/cascadiacode"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_student_programme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Higher National Diploma in Network Engineering"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/cascadiacode"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_student_batch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HNDSE242F"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/cascadiacode"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_forward"
            android:alpha="0.5" />

    </LinearLayout>

</androidx.cardview.widget.CardView>