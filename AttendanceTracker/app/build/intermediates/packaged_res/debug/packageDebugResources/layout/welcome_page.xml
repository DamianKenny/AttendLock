<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/button_black"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="414dp"
        android:layout_height="700dp"
        android:background="@color/button_black"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Doctor Illustration -->
        <ImageView
            android:id="@+id/doctorImage"
            android:layout_width="300dp"
            android:layout_height="320dp"
            android:layout_marginTop="-30dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="Medical professionals illustration"
            android:scaleType="fitXY"
            android:src="@drawable/school3" />

        <!-- Welcome Title -->
        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="360dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/cascadiacode"
            android:text="Welcome to AttendLock"
            android:textColor="@color/white"
            android:textSize="29dp"
            android:textStyle="bold" />

        <!-- Description Text -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:fontFamily="@font/cascadiacode"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Keep track of attendance and classes in one simple application."
            android:textColor="@color/background_light"
            android:textSize="16sp" />

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountButton"
            android:layout_width="240dp"
            android:layout_height="69dp"
            android:padding="10dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/button_background_white"
            app:backgroundTint="@null"
            android:fontFamily="@font/cascadiacode"
            android:text="Create an Account"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp" />




        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="240dp"
            android:layout_height="69dp"
            android:layout_marginBottom="-50dp"
            android:background="@drawable/button_background_white"
            app:backgroundTint="@null"
            android:fontFamily="@font/cascadiacode"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp" />

    </LinearLayout>


</LinearLayout>